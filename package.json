{
  "name": "@shapeshiftoss/revenue-dashboard-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": ">=1.3.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "clean": "rm -rf node_modules && bun --filter './apps/*' clean",
    "build": "bun run --parallel build:backend build:frontend",
    "build:backend": "bun run --filter @shapeshiftoss/revenue-api build",
    "build:frontend": "bun run --filter @shapeshiftoss/revenue-dashboard build",
    "dev": "bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun run --filter @shapeshiftoss/revenue-api dev",
    "dev:frontend": "bun run --filter @shapeshiftoss/revenue-dashboard dev",
    "lint": "eslint --cache .",
    "lint:fix": "bun run lint --fix",
    "format": "prettier --write '**/*.json'",
    "format:check": "prettier --check '**/*.json'",
    "type-check": "bun run --filter './apps/*' type-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
