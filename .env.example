# Copy to .env.local and fill in secrets.
# In production, secrets come from Railway/Vercel dashboards.

# Backend secrets (required) — set in Railway in production
BEBOP_API_KEY=
NEAR_INTENTS_API_KEY=
ZRX_API_KEY=

# Backend config
PORT=4200

# Frontend — set in Vercel in production
VITE_API_BASE_URL=http://localhost:4200
