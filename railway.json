{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install && bun build:backend",
    "watchPatterns": [
      "bun.lock",
      "package.json",
      "tsconfig.json",
      "apps/revenue-api/**"
    ]
  },
  "deploy": {
    "startCommand": "bun apps/revenue-api/dist/server.js",
    "restartPolicyType": "ALWAYS",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "multiRegionConfig": {
      "us-west2": { "numReplicas": 1 }
    }
  }
}
